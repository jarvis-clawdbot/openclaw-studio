# ═══════════════════════════════════════════
# Dashboard Vision — Environment Configuration
# ═══════════════════════════════════════════

# ── OpenClaw Gateway ──
OPENCLAW_GATEWAY_WS=ws://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=

# ── Backend URL (for frontend) ──
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:18789

# ── Database ──
DATABASE_URL=sqlite+aiosqlite:///./data/dashboard.db

# ── Notion Integration ──
NOTION_API_KEY=
NOTION_OPENCLAW_DB=3024fc92-d02d-8016-b4b5-ce4c5ad4b2e9
NOTION_PERSONAL_DB=3034fc92-d02d-80ca-bf20-da4f0ad9e576
NOTION_IDEAS_DB=3034fc92-d02d-8042-afd2-df675475a053
NOTION_SYNC_ENABLED=false

# ── Self-Healing ──
HEALING_ENABLED=true
HEALING_POLL_INTERVAL_SECONDS=15
HEALING_STUCK_THRESHOLD_MINUTES=5
HEALING_MAX_RETRIES=3
HEALING_NUDGE_TIMEOUT_SECONDS=120

# ── Authentication (optional) ──
# DASHBOARD_AUTH_TOKEN=

# ── Server ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
